---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const L = {
  ui: es ? 'interfaz' : 'ui', api: 'api', events: es ? 'eventos' : 'events', data: es ? 'datos' : 'data',
  insights: es ? 'ia' : 'ai', cloud: es ? 'nube' : 'cloud',
};
// Tools per layer: only what the profile lists.
const STACK: Record<string, [string, string]> = {
  ui: [es ? 'Interfaz' : 'UI', 'React, Next.js, TypeScript, Tailwind CSS'],
  api: ['API', 'Java, Spring Boot, NestJS, Node.js, FastAPI, Flask, Django, GraphQL, JWT'],
  events: [es ? 'Eventos' : 'Events', 'Kafka, RabbitMQ, WebSockets, CQRS, circuit breaker'],
  data: [es ? 'Datos' : 'Data', 'PostgreSQL, MongoDB, Redis, Neo4j, BigQuery, Supabase'],
  insights: [es ? 'IA y análisis' : 'AI and insights', 'scikit-learn, XGBoost, Optuna, SHAP, pandas, OpenCV, MediaPipe, Airflow, drift monitoring'],
  cloud: [es ? 'Nube' : 'Cloud', 'Docker, Kubernetes, Terraform, Jenkins, GitHub Actions, AWS, Google Cloud, Azure'],
};
const node = (k: string) => ({ tabindex: 0, role: 'button', 'data-layer': k, 'aria-label': `${STACK[k][0]}: ${STACK[k][1]}` });
---
<figure class="scene" data-stack={JSON.stringify(STACK)}>
  <svg class="px" id="sys" viewBox="0 0 200 92" role="group" aria-label={t('sceneLabel', lang)}>
    <defs><pattern id="dots" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="1" height="1" class="l" /></pattern></defs>
    <rect width="200" height="92" fill="url(#dots)" />

    <g class="node cloud" {...node('cloud')}>
      <rect class="cloudline" x="49.5" y="16.5" width="113" height="70" />
      <text class="lbl" x="66" y="13">{L.cloud}</text>
    </g>

    <g class="sb">
      {[40, 44, 48, 52, 82, 86, 124, 128, 156, 160, 164].map((x) => <rect x={x} y="45" width="2" height="1" />)}
    </g>

    <g class="node" {...node('ui')}>
      <rect class="frame ls" x="4" y="28" width="36" height="32" />
      <rect class="s" x="5" y="29" width="34" height="30" />
      <rect class="s2" x="5" y="29" width="34" height="5" />
      <rect class="m" x="7" y="31" width="2" height="2" /><rect class="m" x="10" y="31" width="2" height="2" /><rect class="m" x="13" y="31" width="2" height="2" />
      <rect class="m" x="8" y="37" width="20" height="2" /><rect class="sb" x="8" y="41" width="14" height="2" /><rect class="sb" x="8" y="45" width="17" height="2" />
      <rect class="click" x="8" y="50" width="12" height="5" />
      <g class="cursor-bob"><rect class="i" x="22" y="52" width="1" height="5" /><rect class="i" x="23" y="53" width="1" height="3" /><rect class="i" x="24" y="54" width="1" height="1" /></g>
      <g class="ok-bubble"><rect class="a" x="22" y="20" width="16" height="7" /><rect class="a" x="24" y="27" width="2" height="2" /><text x="30" y="25.5" style="font:400 5px Silkscreen,monospace;fill:var(--bg);text-anchor:middle">200</text></g>
      <text class="lbl" x="22" y="68">{L.ui}</text>
    </g>

    <g class="node" {...node('api')}>
      <rect class="frame ls" x="58" y="25" width="24" height="40" />
      <rect class="s2" x="59" y="26" width="22" height="38" />
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect class="b" x="61" y={28 + i * 9} width="18" height="7" />
          <rect class="led" style={`animation-delay:-${(i * 0.37) % 1.33}s`} x="63" y={30 + i * 9} width="2" height="2" />
          <rect class="led" style={`animation-delay:-${(i * 0.53 + 0.4) % 1.33}s`} x="66" y={30 + i * 9} width="2" height="2" />
          <rect class="ls" x="70" y={30 + i * 9} width="7" height="1" /><rect class="ls" x="70" y={32 + i * 9} width="7" height="1" />
        </g>
      ))}
      <text class="lbl" x="70" y="73">{L.api}</text>
    </g>

    <g class="node" {...node('events')}>
      <rect class="frame ls" x="90" y="38" width="34" height="1" /><rect class="frame ls" x="90" y="52" width="34" height="1" />
      <rect class="s2" x="90" y="39" width="34" height="13" />
      <rect class="ls" x="89" y="37" width="2" height="17" /><rect class="ls" x="123" y="37" width="2" height="17" />
      <rect class="m" y="42" width="5" height="7"><animate attributeName="x" from="91" to="118" dur="1.33s" repeatCount="indefinite" /></rect>
      <rect class="a" y="42" width="5" height="7"><animate attributeName="x" from="91" to="118" dur="1.33s" begin="-.44s" repeatCount="indefinite" /></rect>
      <rect class="m" y="42" width="5" height="7"><animate attributeName="x" from="91" to="118" dur="1.33s" begin="-.88s" repeatCount="indefinite" /></rect>
      <text class="lbl" x="107" y="73">{L.events}</text>
    </g>

    <g class="node" {...node('data')}>
      <rect class="s2" x="132" y="30" width="24" height="32" />
      <rect class="a" x="133" y="48" width="22" height="14"><animate attributeName="y" values="60;36;36;60" keyTimes="0;.85;.95;1" dur="4s" repeatCount="indefinite" /><animate attributeName="height" values="2;26;26;2" keyTimes="0;.85;.95;1" dur="4s" repeatCount="indefinite" /></rect>
      <rect class="frame ls" x="134" y="27" width="20" height="1" /><rect class="frame ls" x="132" y="28" width="2" height="2" /><rect class="frame ls" x="154" y="28" width="2" height="2" />
      <rect class="s" x="134" y="28" width="20" height="2" /><rect class="frame ls" x="134" y="30" width="20" height="1" />
      <rect class="frame ls" x="132" y="30" width="1" height="33" /><rect class="frame ls" x="155" y="30" width="1" height="33" />
      <rect class="ls" x="133" y="41" width="22" height="1" /><rect class="ls" x="133" y="51" width="22" height="1" />
      <rect class="frame ls" x="134" y="63" width="20" height="1" />
      <text class="lbl" x="144" y="73">{L.data}</text>
    </g>

    <g class="node" {...node('insights')}>
      <rect class="frame m" x="168" y="27" width="1" height="36" /><rect class="frame m" x="168" y="62" width="28" height="1" />
      {[
        { x: 172, c: 'a', h: '6;20;10;26;6' }, { x: 178, c: 'm', h: '14;8;24;12;14' },
        { x: 184, c: 'a', h: '22;12;6;18;22' }, { x: 190, c: 'm', h: '10;26;16;8;10' },
      ].map((b) => (
        <rect class={b.c} x={b.x} y={62 - +b.h.split(';')[0]} width="4" height={b.h.split(';')[0]}>
          <animate attributeName="height" values={b.h} dur="1.33s" repeatCount="indefinite" />
          <animate attributeName="y" values={b.h.split(';').map((v) => 62 - +v).join(';')} dur="1.33s" repeatCount="indefinite" />
        </rect>
      ))}
      <text class="lbl" x="182" y="73">{L.insights}</text>
    </g>

    <rect class="a" x="-2" y="-2" width="4" height="4"><animateMotion dur="4s" repeatCount="indefinite" path="M20 52 L20 45 L170 45" keyPoints="0;1;1" keyTimes="0;.85;1" calcMode="linear" /><animate attributeName="opacity" values="1;1;0;0" keyTimes="0;.84;.85;1" dur="4s" repeatCount="indefinite" /></rect>
    <rect class="i" x="-1" y="-1" width="2" height="2"><animateMotion dur="4s" begin="-2s" repeatCount="indefinite" path="M20 52 L20 45 L170 45" keyPoints="0;1;1" keyTimes="0;.85;1" calcMode="linear" /><animate attributeName="opacity" values="1;1;0;0" keyTimes="0;.84;.85;1" dur="4s" begin="-2s" repeatCount="indefinite" /></rect>
  </svg>
  <figcaption class="scene-cap" aria-live="polite"><span id="cap-k">{t('sceneHint', lang)}</span><b id="cap-v">{t('sceneHint2', lang)}</b></figcaption>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('figure.scene[data-stack]');
  if (fig) {
    const stack = JSON.parse(fig.dataset.stack!) as Record<string, [string, string]>;
    const k = fig.querySelector('#cap-k')!, v = fig.querySelector('#cap-v')!;
    const nodes = fig.querySelectorAll<SVGGElement>('.node');
    const pick = (n: SVGGElement) => {
      nodes.forEach((x) => x.classList.toggle('on', x === n));
      const [name, tools] = stack[n.dataset.layer!];
      k.textContent = name; v.textContent = tools;
    };
    nodes.forEach((n) => {
      n.addEventListener('mouseenter', (e) => { e.stopPropagation(); pick(n); });
      n.addEventListener('focus', () => pick(n));
      n.addEventListener('click', (e) => { e.stopPropagation(); pick(n); });
      n.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(n); } });
    });
  }
</script>
