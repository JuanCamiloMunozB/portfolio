---
/**
 * One skill area: pixel area icon, a grid of one-color tool logos (Simple Icons, CC0)
 * drawn in the theme's muted color on a transparent tile, and concept tags.
 */
import Scene from './Scene.astro';
import { logo } from '../data/logos';
import type { SkillArea } from '../data/skills';
import { tx, t, type Lang } from '../i18n/ui';

interface Props { area: SkillArea; lang: Lang; evidence: { href: string; title: string }[] }
const { area, lang, evidence } = Astro.props;

const tiles = area.tools.map((n) => {
  const l = logo(n);
  if (!l) throw new Error(`Skill "${n}" has no logo; add one in src/data/logos.ts or remove it`);
  return { name: n, ...l };
});
---
<article class="skill">
  <header>
    <div class="icon"><Scene name={area.icon} /></div>
    <h3>{tx(area.title, lang)}</h3>
  </header>
  <ul class="tiles">
    {tiles.map((x) => (
      <li class={`tile${x.name.split(' ').some((w) => w.length > 10) ? ' long' : ''}`} data-tile>
        <svg viewBox={x.viewBox} aria-hidden="true"><path d={x.d} /></svg>
        <span>{x.name}</span>
      </li>
    ))}
  </ul>
  <div class="ev">{t('seenIn', lang)}: {evidence.map((e, i) => <>{i > 0 && ', '}<a href={e.href}>{e.title}</a></>)}</div>
</article>
