<style is:global>
  .rr-up { animation: rrup 4s ease-in-out infinite; transform-box: fill-box; }
  @keyframes rrup { 0%, 30% { transform: translateY(0); } 50%, 90% { transform: translateY(-26px); } 100% { transform: translateY(0); } }
  .rr-down { animation: rrdown 4s ease-in-out infinite; transform-box: fill-box; }
  @keyframes rrdown { 0%, 30% { transform: translateY(0); } 50%, 90% { transform: translateY(13px); } 100% { transform: translateY(0); } }
  .pose-a { animation: posea .9s steps(1) infinite; }
  .pose-b { animation: poseb .9s steps(1) infinite; }
  @keyframes posea { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes poseb { 0%, 49% { opacity: 0; } 50%, 100% { opacity: 1; } }
  .feed { animation: feed 1.5s ease-in infinite; transform-box: fill-box; }
  @keyframes feed { 0% { transform: translateX(0); opacity: 1; } 70% { transform: translateX(5px); opacity: 1; } 100% { transform: translateX(6px); opacity: 0; } }
  .tagflip { animation: tagflip 4s steps(1) infinite; }
  @keyframes tagflip { 0%, 4% { opacity: 0; } 5%, 74% { opacity: 1; } 75%, 100% { opacity: 0; } }
  .typeline { animation: typeline 4s steps(6) infinite; transform-box: fill-box; transform-origin: 0 50%; }
  @keyframes typeline { 0% { transform: scaleX(0); } 30%, 90% { transform: scaleX(1); } 100% { transform: scaleX(0); } }
  .file { animation: file 4s ease-in-out infinite; transform-box: fill-box; }
  @keyframes file { 0%, 45% { transform: translate(-48px, 6px); opacity: 0; } 55% { opacity: 1; } 75%, 92% { transform: translate(0, 0); opacity: 1; } 100% { transform: translate(0, 0); opacity: 0; } }
  .orbit { animation: orbit 2.66s steps(12) infinite; transform-box: view-box; transform-origin: 17px 30px; }
  @keyframes orbit { to { transform: rotate(360deg); } }
  .slide-agile { animation: slideag 3s ease-in-out infinite; transform-box: fill-box; }
  @keyframes slideag { 0%, 20% { transform: translateX(0); } 40%, 60% { transform: translateX(10px); } 80%, 100% { transform: translateX(20px); } }
  .slide18 { animation: slide18 4.5s ease-in-out infinite; transform-box: fill-box; }
  @keyframes slide18 { 0%, 18% { transform: translateX(0); } 33%, 52% { transform: translateX(18px); } 67%, 90% { transform: translateX(36px); } 100% { transform: translateX(36px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pose-b { opacity: 0; } .tagflip, .file { opacity: 1; } }
</style>
