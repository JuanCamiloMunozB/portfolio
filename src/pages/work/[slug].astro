---
import CasePage from '../../components/CasePage.astro';
import { withCase, type Project } from '../../data/projects';
export function getStaticPaths() {
  return withCase.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
---
<CasePage lang="en" project={project} />
