---
/** Contact icons. GitHub comes from Simple Icons (CC0); the rest are original 16x16 pixel icons. All use currentColor. */
import { siGithub, siGoogledrive } from 'simple-icons';
interface Props { name: 'github' | 'linkedin' | 'mail' | 'cv' | 'copy' | 'sun' | 'moon' | 'eye' | 'download' | 'drive'; size?: number }
const { name, size = 20 } = Astro.props;
// Pixel icons as [x, y, w, h] rects on a 16x16 grid
const PX: Record<string, number[][]> = {
  linkedin: [[1, 1, 14, 1], [1, 14, 14, 1], [1, 1, 1, 14], [14, 1, 1, 14], [4, 4, 2, 2], [4, 7, 2, 5], [7, 7, 2, 5], [8, 7, 3, 2], [10, 8, 2, 4]],
  mail: [[1, 3, 14, 1], [1, 12, 14, 1], [1, 3, 1, 10], [14, 3, 1, 10], [2, 4, 1, 1], [3, 5, 1, 1], [4, 6, 1, 1], [5, 7, 1, 1], [6, 8, 1, 1], [7, 9, 2, 1], [9, 8, 1, 1], [10, 7, 1, 1], [11, 6, 1, 1], [12, 5, 1, 1], [13, 4, 1, 1]],
  cv: [[3, 1, 7, 1], [3, 1, 1, 14], [3, 14, 10, 1], [12, 4, 1, 11], [10, 1, 1, 3], [10, 3, 3, 1], [7, 5, 2, 4], [5, 9, 6, 1], [6, 10, 4, 1], [7, 11, 2, 1]],
  sun: [[6, 5, 4, 6], [5, 6, 6, 4], [7, 0, 2, 3], [7, 13, 2, 3], [0, 7, 3, 2], [13, 7, 3, 2], [2, 2, 2, 2], [12, 2, 2, 2], [2, 12, 2, 2], [12, 12, 2, 2]],
  moon: [[6, 1, 3, 1], [4, 2, 4, 1], [3, 3, 4, 1], [2, 4, 4, 1], [1, 5, 5, 1], [1, 6, 5, 1], [1, 7, 5, 1], [1, 8, 5, 1], [1, 9, 6, 1], [1, 10, 7, 1], [2, 11, 7, 1], [3, 12, 9, 1], [4, 13, 7, 1], [6, 14, 3, 1], [12, 2, 1, 3], [11, 3, 3, 1]],
  eye: [[5, 4, 6, 1], [3, 5, 2, 1], [11, 5, 2, 1], [1, 6, 2, 1], [13, 6, 2, 1], [0, 7, 1, 2], [15, 7, 1, 2], [1, 9, 2, 1], [13, 9, 2, 1], [3, 10, 2, 1], [11, 10, 2, 1], [5, 11, 6, 1], [6, 6, 4, 4]],
  download: [[7, 1, 2, 8], [4, 6, 2, 2], [10, 6, 2, 2], [5, 8, 6, 1], [6, 9, 4, 1], [7, 10, 2, 1], [1, 12, 1, 3], [14, 12, 1, 3], [1, 14, 14, 1]],
  copy: [[1, 1, 9, 1], [1, 1, 1, 9], [1, 9, 3, 1], [9, 1, 1, 3], [5, 5, 10, 1], [5, 5, 1, 10], [5, 14, 10, 1], [14, 5, 1, 10]],
};
---
{name === 'github' || name === 'drive'
  ? <svg class="ico" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d={name === 'github' ? siGithub.path : siGoogledrive.path} fill="currentColor" /></svg>
  : <svg class="ico" viewBox="0 0 16 16" width={size} height={size} aria-hidden="true" shape-rendering="crispEdges" fill="currentColor">{PX[name].map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}</svg>}
