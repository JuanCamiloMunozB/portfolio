---
/**
 * Animated pixel scenes. Each one shows what a project, certification or skill area
 * does, drawn only with palette tokens so it follows the theme.
 */
interface Props { name: string; label?: string; lang?: 'en' | 'es' }
const { name, label, lang = 'en' } = Astro.props;
const es = lang === 'es';
const role = label ? 'img' : undefined;
const hidden = label ? undefined : 'true';

// IRL radar: six readiness axes around (48,30). Profile A is the first diagnosis (weakest axis:
// lower right), B is after INNLAB services close that gap. The polygon morphs between them.
const AXES = [[0, -26], [22.5, -13], [22.5, 13], [0, 26], [-22.5, 13], [-22.5, -13]];
const pts = (v: number[]) => v.map((k, i) => `${(48 + AXES[i][0] * k).toFixed(1)},${(30 + AXES[i][1] * k).toFixed(1)}`).join(' ');
const RADAR_A = pts([0.8, 0.7, 0.35, 0.75, 0.6, 0.65]);
const RADAR_B = pts([0.85, 0.75, 0.75, 0.8, 0.65, 0.7]);
const GAP_A = [48 + 22.5 * 0.35, 30 + 13 * 0.35], GAP_B = [48 + 22.5 * 0.75, 30 + 13 * 0.75];
// Cloud for the Google Cloud scene, shaped like its logo: a large dome on the right, a smaller lobe on the left,
// a flat base with rounded ends and a thick outline in four segments. Rasterized on a 2-unit grid.
const inCloud = (x: number, y: number) =>
  (x - 52) ** 2 + (y - 26) ** 2 <= 22 ** 2 || (x - 25) ** 2 + (y - 36) ** 2 <= 13 ** 2 ||
  (x >= 18 && x <= 72 && y >= 34 && y <= 56) || (x - 18) ** 2 + (y - 45) ** 2 <= 11 ** 2 || (x - 72) ** 2 + (y - 45) ** 2 <= 11 ** 2;
const seg = (x: number, y: number) => { const a = Math.atan2(y - 38, x - 46) * 180 / Math.PI; return a < -135 || a > 150 ? 'm' : a < -40 ? 'a' : a < 60 ? 'i' : 'sb'; };
const CLOUD: { x: number; y: number; c: string }[] = [];
for (let y = 2; y < 58; y += 2) for (let x = 4; x < 86; x += 2) if (inCloud(x, y) && y <= 56) {
  const edge = ![[4, 0], [-4, 0], [0, 4], [0, -4], [3, 3], [-3, 3], [3, -3], [-3, -3]].every(([dx, dy]) => inCloud(x + dx, y + dy) && y + dy <= 56);
  CLOUD.push({ x, y, c: edge ? seg(x, y) : 's' });
}
